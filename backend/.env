PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/digiex_hrms

# SMTP configuration for email notifications (e.g. Gmail, Mailtrap, AWS SES)
# Leave SMTP_USER and SMTP_PASS empty to log emails to the console instead
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DIGIEX HRMS" <noreply@digiexweb.com>

# SMS configuration (e.g. MSG91, Twilio or standard HTTP SMS Gateway)
# Leave SMS_API_URL empty to log SMS messages to the console instead
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=DIGIEX
